{
  "name": "litterly",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*"],
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "mobile": "npm run start -w @litterly/mobile",
    "web": "npm run web -w @litterly/mobile",
    "api": "npm run dev -w @litterly/api",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint -w @litterly/mobile",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": { "supabase": "2.67.1", "typescript": "6.0.3" },
  "overrides": {
    "supabase": { "tar": "7.5.23" },
    "minimatch@>=7 <11.0.1": "11.0.8"
  }
}
